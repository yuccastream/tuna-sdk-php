{
    "name": "yuccastream/tuna-sdk-php",
    "description": "Expose local HTTP and TCP services through tuna.am tunnels",
    "type": "library",
    "keywords": ["tunnel", "tuna", "webhooks", "localhost"],
    "homepage": "https://tuna.am",
    "license": "MIT",
    "authors": [
        {"name": "tuna.am authors", "email": "info@tuna.am"}
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0"
    },
    "suggest": {
        "ext-pcntl": "Close the tunnel cleanly on SIGTERM and SIGINT in CLI scripts"
    },
    "autoload": {
        "psr-4": {"Tuna\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Tuna\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true
    }
}
